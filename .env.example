# Biến môi trường mẫu cho VietASL Web
# Dự án chạy 100% Client-Side trong trình duyệt, không yêu cầu API key máy chủ cho MVP cốt lõi.

# Cổng khởi chạy máy chủ phát triển
VITE_PORT=3000
VITE_HOST=127.0.0.1

# Cấu hình ngôn ngữ mặc định
VITE_DEFAULT_UI_LANG=vi-VN
VITE_DEFAULT_SIGN_LANG=ASL

# URL dịch vụ mở rộng (nếu kết nối AI Cloud Translation Provider trong tương lai)
# VITE_TRANSLATION_API_URL=https://api.example.com/v1/translate
